{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
    "${mod_credits}"
  ],
  "contact": {
    "sources": "${mod_url}",
    "issues": "${mod_tracker}"
  },
  "license": [
    "${mod_license}",
    "AetherFabric Code: LGPL-2.1"
  ],
  "icon": "${mod_id}.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.aetherteam.aether.Aether"
    ],
    "client": [
      "com.aetherteam.aether.client.AetherClient"
    ],
    "fabric-datagen": [
      "com.aetherteam.aether.data.AetherData"
    ],
    "rei_client": [
      "com.aetherteam.aether.integration.rei.AetherREIClientPlugin"
    ],
    "rei_server": [
      "com.aetherteam.aether.integration.rei.AetherREIServerPlugin"
    ],
    "jei_mod_plugin": [
      "com.aetherteam.aether.integration.jei.AetherJEIPlugin"
    ],
    "mm_shedaniel:early_risers": [
      "com.aetherteam.aetherfabric.AetherASM"
    ],
    "cumulus:menu_initializers": [
      "com.aetherteam.aether.api.AetherMenus"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "${fabric_version_range}",
    "accessories": "*"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1297": [
        "net/fabricmc/fabric/api/attachment/v1/AttachmentTarget"
      ],
      "net/minecraft/class_1937": [
        "net/fabricmc/fabric/api/attachment/v1/AttachmentTarget"
      ],
      "net/minecraft/class_1799": [
        "net/fabricmc/fabric/api/item/v1/FabricItemStack"
      ],
      "net/minecraft/class_8610": [
        "net/fabricmc/fabric/api/networking/v1/FabricServerConfigurationNetworkHandler"
      ]
    }
  }
}